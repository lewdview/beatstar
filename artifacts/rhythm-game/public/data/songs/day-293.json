  "lyricsSegments": [
    {
      "end": 4.900000095367432,
      "text": "Hey, I see you out there in Hartford, man.",
      "start": 1.1799999475479126
    },
    {
      "end": 7.21999979019165,
      "text": "Don't stay too long, okay?",
      "start": 5.28000020980835
    },
    {
      "end": 9.239999771118164,
      "text": "Because the world needs a light.",
      "start": 7.699999809265137
    },
    {
      "end": 13.100000381469727,
      "text": "And, hey, no matter what's come,",
      "start": 10.979999542236328
    },
    {
      "end": 18.200000762939453,
      "text": "you know, you know, you know, you know, hey.",
      "start": 14.239999771118164
    },
    {
      "end": 22.5,
      "text": "You know, you know, you, you.",
      "start": 18.5
    },
    {
      "end": 26.559999465942383,
      "text": "You know, you know, you, hey.",
      "start": 22.979999542236328
    },
    {
      "end": 29.440000534057617,
      "text": "It's getting a little lighter.",
      "start": 26.559999465942383
    },
    {
      "end": 33.560001373291016,
      "text": "I can see the sun rays come through those dark blinds,",
      "start": 30.420000076293945
    },
    {
      "end": 35.279998779296875,
      "text": "open all the way.",
      "start": 34.2400016784668
    },
    {
      "end": 37.560001373291016,
      "text": "Know you've been sitting inside for a while.",
      "start": 35.619998931884766
    },
    {
